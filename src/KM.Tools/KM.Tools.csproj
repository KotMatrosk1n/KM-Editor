<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\KM.Api\KM.Api.csproj" />
    <ProjectReference Include="..\KM.Core\KM.Core.csproj" />
    <ProjectReference Include="..\KM.PLA\KM.PLA.csproj" />
    <ProjectReference Include="..\KM.Formats\KM.Formats.csproj" />
    <ProjectReference Include="..\KM.SV\KM.SV.csproj" />
    <ProjectReference Include="..\KM.SwSh\KM.SwSh.csproj" />
    <ProjectReference Include="..\KM.ZA\KM.ZA.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../apps/desktop/src/bridge/supportInventoryCatalog.json"
                      LogicalName="KM.Tools.SupportInventoryCatalog.json" />
    <EmbeddedResource Include="Resources\km-native-settings.nso"
                      LogicalName="KM.Tools.Resources.km-native-settings.nso" />
    <EmbeddedResource Include="Resources/PartySprites/*.png"
                      LogicalName="KM.Tools.PartySprites.%(Filename)%(Extension)" />
    <None Update="Resources/PartySprites/NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Resources/PartySprites/POKEMON-WORKSHOP-LICENSE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Desktop workers repeatedly inspect large archives and executables. Reclaim
         temporary large-object allocations without waiting for system-wide pressure. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>KM Editor Worker</AssemblyTitle>
    <Product>KM Editor</Product>
    <ApplicationIcon>..\..\apps\desktop\src-tauri\icons\icon.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
