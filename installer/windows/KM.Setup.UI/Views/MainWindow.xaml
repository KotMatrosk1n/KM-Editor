<Window
    x:Class="KM.Setup.UI.Views.MainWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localization="clr-namespace:KM.Setup.UI.Localization"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="{Binding WindowTitle}"
    Width="760"
    Height="440"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    Closing="OnWindowClosing">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome
        CaptionHeight="52"
        CornerRadius="8"
        GlassFrameThickness="0"
        ResizeBorderThickness="6"
        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Border
      Background="{StaticResource KmBackgroundBrush}"
      BorderBrush="{StaticResource KmBorderStrongBrush}"
      BorderThickness="1"
      CornerRadius="8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border
          Grid.Row="0"
          Background="{StaticResource KmBackgroundDeepBrush}"
          BorderBrush="{StaticResource KmBorderBrush}"
          BorderThickness="0,0,0,1"
          CornerRadius="8,8,0,0"
          MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
        <Grid Margin="14,0,6,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Image
              Width="30"
              Height="30"
              Source="/KM.Setup.UI;component/Assets/km-logo.png"
              Stretch="Uniform" />
          <TextBlock
              Grid.Column="1"
              Margin="10,0,0,0"
              VerticalAlignment="Center"
              FontSize="14"
              FontWeight="Bold"
              Text="{Binding WindowTitle}" />
          <Button
              Grid.Column="2"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              AutomationProperties.Name="{localization:Loc CloseWindowAutomationName}"
              Command="{Binding CloseCommand}"
              Content="×"
              Style="{StaticResource TitleBarButtonStyle}" />
        </Grid>
      </Border>

      <ScrollViewer
          Grid.Row="1"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
      <Grid Margin="30,24,30,24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock
                Style="{StaticResource EyebrowTextStyle}"
                Text="{localization:Loc InstallerEyebrow}" />
            <TextBlock
                Margin="0,7,0,0"
                Style="{StaticResource HeadingTextStyle}"
                Text="{Binding Heading}"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,6,24,0"
                MaxWidth="560"
                Style="{StaticResource DescriptionTextStyle}"
                Text="{Binding Description}"
                TextWrapping="Wrap" />
          </StackPanel>
          <Border
              Grid.Column="1"
              Width="66"
              Height="66"
              Padding="9"
              Background="{StaticResource KmSurfaceBrush}"
              BorderBrush="{StaticResource KmBorderBrush}"
              BorderThickness="1"
              CornerRadius="14">
            <Image Source="/KM.Setup.UI;component/Assets/km-logo.png" Stretch="Uniform" />
          </Border>
        </Grid>

        <Border
            Grid.Row="1"
            Margin="0,20,0,0"
            Padding="18"
            Background="{StaticResource KmSurfaceMutedBrush}"
            BorderBrush="{StaticResource KmBorderBrush}"
            BorderThickness="1"
            CornerRadius="9"
            Visibility="{Binding ShowProgressPage, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                  Style="{StaticResource LabelTextStyle}"
                  Text="{localization:Loc CurrentPackageLabel}" />
              <TextBlock
                  Grid.Column="1"
                  Foreground="{StaticResource KmGoldBrush}"
                  FontWeight="Bold"
                  Text="{Binding ProgressText}"
                  Visibility="{Binding ShowProgressPercentage, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
            <TextBlock
                Margin="0,7,0,11"
                MinHeight="20"
                Foreground="{StaticResource KmTextSoftBrush}"
                Text="{Binding CurrentPackage}"
                TextWrapping="Wrap" />
            <ProgressBar
                IsIndeterminate="{Binding IsIndeterminate}"
                Maximum="100"
                Minimum="0"
                Value="{Binding ProgressPercent, Mode=OneWay}" />
          </StackPanel>
        </Border>

        <Border
            Grid.Row="1"
            Margin="0,20,0,0"
            Padding="18"
            Background="{StaticResource KmSurfaceMutedBrush}"
            BorderBrush="{StaticResource KmBorderBrush}"
            BorderThickness="1"
            CornerRadius="9"
            Visibility="{Binding ShowUninstallAction, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <TextBlock
                Margin="0,0,0,12"
                Foreground="{StaticResource KmWarningBrush}"
                Text="{Binding ErrorMessage}"
                TextWrapping="Wrap"
                Visibility="{Binding ShowBlockedPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock
                Margin="0,0,0,10"
                Style="{StaticResource LabelTextStyle}"
                Text="{localization:Loc UninstallOptionsHeading}" />
            <CheckBox
                Content="{localization:Loc DeleteUserSettingsLabel}"
                IsChecked="{Binding DeleteUserSettings, Mode=TwoWay}" />
            <TextBlock
                Margin="28,6,0,0"
                Foreground="{StaticResource KmTextMutedBrush}"
                FontSize="12"
                Text="{localization:Loc DeleteUserSettingsDescription}"
                TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border
            Grid.Row="1"
            Margin="0,20,0,0"
            Padding="18"
            Background="{StaticResource KmSurfaceMutedBrush}"
            BorderBrush="{StaticResource KmBorderBrush}"
            BorderThickness="1"
            CornerRadius="9"
            Visibility="{Binding ShowInstallOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <CheckBox
                Content="{localization:Loc CreateStartMenuShortcutLabel}"
                IsChecked="{Binding CreateStartMenuShortcut}" />
            <CheckBox
                Content="{localization:Loc CreateDesktopShortcutLabel}"
                IsChecked="{Binding CreateDesktopShortcut}" />
          </StackPanel>
        </Border>

        <Border
            Grid.Row="1"
            Margin="0,20,0,0"
            Padding="18"
            Background="#2B2113"
            BorderBrush="#795C25"
            BorderThickness="1"
            CornerRadius="9"
            Visibility="{Binding ShowCompletionNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBlock
              Foreground="{StaticResource KmWarningBrush}"
              Text="{Binding CompletionNotice}"
              TextWrapping="Wrap" />
        </Border>

        <Border
            Grid.Row="1"
            Margin="0,20,0,0"
            Padding="18"
            Background="#2A1519"
            BorderBrush="#71323A"
            BorderThickness="1"
            CornerRadius="9"
            Visibility="{Binding ShowFailurePage, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <TextBlock Style="{StaticResource LabelTextStyle}" Text="{localization:Loc ErrorDetailsLabel}" />
            <TextBlock
                Margin="0,7,0,0"
                Foreground="#FFB0B0"
                Text="{Binding ErrorMessage}"
                TextWrapping="Wrap" />
            <TextBlock Margin="0,14,0,0" Style="{StaticResource LabelTextStyle}" Text="{localization:Loc LogFileLabel}" />
            <TextBox Margin="0,7,0,0" IsReadOnly="True" Text="{Binding LogPath, Mode=OneWay}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border
            Grid.Row="1"
            Margin="0,20,0,0"
            Padding="18"
            Background="#2B2113"
            BorderBrush="#795C25"
            BorderThickness="1"
            CornerRadius="9"
            >
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding ShowBlockedPage}" Value="True" />
                    <Condition Binding="{Binding ShowUninstallAction}" Value="False" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock
              Foreground="{StaticResource KmWarningBrush}"
              Text="{Binding ErrorMessage}"
              TextWrapping="Wrap" />
        </Border>

        <Border
            Grid.Row="1"
            Margin="0,20,0,0"
            Padding="18"
            Background="{StaticResource KmSurfaceMutedBrush}"
            BorderBrush="{StaticResource KmBorderBrush}"
            BorderThickness="1"
            CornerRadius="9"
            Visibility="{Binding ShowCancelledPage, Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBlock Foreground="{StaticResource KmTextSoftBrush}" Text="{Binding Description}" />
        </Border>

        <Grid Grid.Row="2" Margin="0,20,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock
              Margin="0,0,16,0"
              VerticalAlignment="Center"
              Foreground="{StaticResource KmTextMutedBrush}"
              FontSize="12"
              Text="{Binding VersionText}" />
          <WrapPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button
                Margin="0,0,10,0"
                Command="{Binding OpenLogCommand}"
                Content="{localization:Loc OpenLogButton}"
                Style="{StaticResource ButtonBaseStyle}"
                Visibility="{Binding ShowFailurePage, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button
                Margin="0,0,10,0"
                Command="{Binding TryAgainCommand}"
                Content="{localization:Loc TryAgainButton}"
                Style="{StaticResource ButtonBaseStyle}"
                Visibility="{Binding ShowFailurePage, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button
                Margin="0,0,10,0"
                Command="{Binding RepairCommand}"
                Content="{localization:Loc RepairButton}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ShowReadyPage}" Value="True" />
                        <Condition Binding="{Binding Installed}" Value="True" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button
                Margin="0,0,10,0"
                Command="{Binding UninstallCommand}"
                Content="{localization:Loc UninstallButton}"
                Style="{StaticResource DangerButtonStyle}"
                Visibility="{Binding ShowUninstallAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button
                Command="{Binding InstallCommand}"
                Content="{Binding PrimaryActionText}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ShowReadyPage}" Value="True" />
                        <Condition Binding="{Binding Installed}" Value="False" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button
                Command="{Binding CancelCommand}"
                Content="{localization:Loc CancelButton}"
                Style="{StaticResource ButtonBaseStyle}"
                Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button
                Margin="0,0,10,0"
                Command="{Binding CloseCommand}"
                Content="{localization:Loc FinishButton}"
                Style="{StaticResource ButtonBaseStyle}"
                Visibility="{Binding ShowRestartAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button
                Command="{Binding RestartNowCommand}"
                Content="{localization:Loc RestartNowButton}"
                Style="{StaticResource PrimaryButtonStyle}"
                Visibility="{Binding ShowRestartAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button
                Command="{Binding CloseCommand}"
                Content="{localization:Loc FinishButton}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ShowSuccessPage}" Value="True" />
                        <Condition Binding="{Binding ShowRestartAction}" Value="False" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button
                Command="{Binding CloseCommand}"
                Content="{localization:Loc CloseButton}"
                Style="{StaticResource ButtonBaseStyle}"
                Visibility="{Binding ShowCancelledPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button
                Command="{Binding CloseCommand}"
                Content="{localization:Loc CloseButton}"
                Style="{StaticResource ButtonBaseStyle}"
                Visibility="{Binding ShowBlockedPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button
                Command="{Binding CloseCommand}"
                Content="{localization:Loc CloseButton}"
                Style="{StaticResource ButtonBaseStyle}"
                Visibility="{Binding ShowFailurePage, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </WrapPanel>
        </Grid>
      </Grid>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
