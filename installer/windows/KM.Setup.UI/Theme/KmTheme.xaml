<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="KmBackgroundColor">#070B12</Color>
  <Color x:Key="KmBackgroundDeepColor">#050814</Color>
  <Color x:Key="KmSurfaceColor">#121B2D</Color>
  <Color x:Key="KmSurfaceStrongColor">#18233A</Color>
  <Color x:Key="KmSurfaceMutedColor">#0D1424</Color>
  <Color x:Key="KmBorderColor">#26344D</Color>
  <Color x:Key="KmBorderStrongColor">#3B4D70</Color>
  <Color x:Key="KmTextColor">#F4F7FB</Color>
  <Color x:Key="KmTextMutedColor">#9AA7BD</Color>
  <Color x:Key="KmTextSoftColor">#C8D3E7</Color>
  <Color x:Key="KmAccentColor">#4F46E5</Color>
  <Color x:Key="KmAccentBrightColor">#6D73FF</Color>
  <Color x:Key="KmAccentDarkColor">#302E86</Color>
  <Color x:Key="KmGoldColor">#D6A842</Color>
  <Color x:Key="KmSuccessColor">#58D17C</Color>
  <Color x:Key="KmWarningColor">#E0AC42</Color>
  <Color x:Key="KmDangerColor">#FF6B6B</Color>

  <SolidColorBrush x:Key="KmBackgroundBrush" Color="{StaticResource KmBackgroundColor}" />
  <SolidColorBrush x:Key="KmBackgroundDeepBrush" Color="{StaticResource KmBackgroundDeepColor}" />
  <SolidColorBrush x:Key="KmSurfaceBrush" Color="{StaticResource KmSurfaceColor}" />
  <SolidColorBrush x:Key="KmSurfaceStrongBrush" Color="{StaticResource KmSurfaceStrongColor}" />
  <SolidColorBrush x:Key="KmSurfaceMutedBrush" Color="{StaticResource KmSurfaceMutedColor}" />
  <SolidColorBrush x:Key="KmBorderBrush" Color="{StaticResource KmBorderColor}" />
  <SolidColorBrush x:Key="KmBorderStrongBrush" Color="{StaticResource KmBorderStrongColor}" />
  <SolidColorBrush x:Key="KmTextBrush" Color="{StaticResource KmTextColor}" />
  <SolidColorBrush x:Key="KmTextMutedBrush" Color="{StaticResource KmTextMutedColor}" />
  <SolidColorBrush x:Key="KmTextSoftBrush" Color="{StaticResource KmTextSoftColor}" />
  <SolidColorBrush x:Key="KmAccentBrush" Color="{StaticResource KmAccentColor}" />
  <SolidColorBrush x:Key="KmAccentBrightBrush" Color="{StaticResource KmAccentBrightColor}" />
  <SolidColorBrush x:Key="KmAccentDarkBrush" Color="{StaticResource KmAccentDarkColor}" />
  <SolidColorBrush x:Key="KmGoldBrush" Color="{StaticResource KmGoldColor}" />
  <SolidColorBrush x:Key="KmSuccessBrush" Color="{StaticResource KmSuccessColor}" />
  <SolidColorBrush x:Key="KmWarningBrush" Color="{StaticResource KmWarningColor}" />
  <SolidColorBrush x:Key="KmDangerBrush" Color="{StaticResource KmDangerColor}" />

  <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="Inter, Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource KmTextBrush}" />
    <Setter Property="Background" Value="{StaticResource KmBackgroundBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
  </Style>

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource KmTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="EyebrowTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource KmGoldBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style x:Key="HeadingTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource KmTextBrush}" />
    <Setter Property="FontSize" Value="25" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="LineHeight" Value="32" />
  </Style>

  <Style x:Key="DescriptionTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource KmTextSoftBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="21" />
  </Style>

  <Style x:Key="LabelTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource KmTextMutedBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style x:Key="ButtonBaseStyle" TargetType="Button">
    <Setter Property="MinWidth" Value="112" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="18,9" />
    <Setter Property="Foreground" Value="{StaticResource KmTextBrush}" />
    <Setter Property="Background" Value="{StaticResource KmSurfaceStrongBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource KmBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border
              x:Name="Chrome"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="7">
            <ContentPresenter
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource KmGoldBrush}" />
              <Setter TargetName="Chrome" Property="Background" Value="#243250" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource KmAccentBrightBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="#0D1424" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.46" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
    <Setter Property="Background" Value="{StaticResource KmAccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource KmAccentBrightBrush}" />
  </Style>

  <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
    <Setter Property="Foreground" Value="#FFB0B0" />
    <Setter Property="Background" Value="#33191D" />
    <Setter Property="BorderBrush" Value="#7A313A" />
  </Style>

  <Style x:Key="TitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="FontSize" Value="19" />
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource KmTextSoftBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,5" />
  </Style>

  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource KmAccentBrightBrush}" />
    <Setter Property="Background" Value="{StaticResource KmBackgroundDeepBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource KmBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="TemplateRoot" ClipToBounds="True" SnapsToDevicePixels="True">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="ProgressStates">
                <VisualState x:Name="Determinate" />
                <VisualState x:Name="Indeterminate">
                  <Storyboard>
                    <DoubleAnimation
                        Storyboard.TargetName="PART_Indicator"
                        Storyboard.TargetProperty="Opacity"
                        To="0"
                        Duration="0" />
                    <DoubleAnimation
                        Storyboard.TargetName="IndeterminateIndicator"
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0" />
                    <DoubleAnimation
                        Storyboard.TargetName="IndeterminateTranslate"
                        Storyboard.TargetProperty="X"
                        From="-180"
                        To="980"
                        Duration="0:0:1.35"
                        RepeatBehavior="Forever" />
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="7" />
            <Border
                x:Name="PART_Track"
                Margin="2"
                Background="Transparent"
                CornerRadius="5" />
            <Border
                x:Name="PART_Indicator"
                Margin="2"
                HorizontalAlignment="Left"
                CornerRadius="5">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Offset="0" Color="{StaticResource KmAccentColor}" />
                  <GradientStop Offset="1" Color="{StaticResource KmAccentBrightColor}" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Border
                x:Name="IndeterminateIndicator"
                Width="168"
                Margin="2"
                HorizontalAlignment="Left"
                CornerRadius="5"
                Opacity="0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Offset="0" Color="Transparent" />
                  <GradientStop Offset="0.35" Color="{StaticResource KmAccentColor}" />
                  <GradientStop Offset="0.7" Color="{StaticResource KmAccentBrightColor}" />
                  <GradientStop Offset="1" Color="Transparent" />
                </LinearGradientBrush>
              </Border.Background>
              <Border.RenderTransform>
                <TranslateTransform x:Name="IndeterminateTranslate" X="-180" />
              </Border.RenderTransform>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="TemplateRoot" Property="Opacity" Value="0.48" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource KmTextSoftBrush}" />
    <Setter Property="Background" Value="{StaticResource KmBackgroundDeepBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource KmBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10" />
  </Style>
</ResourceDictionary>
