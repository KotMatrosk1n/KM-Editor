fn gem_uv(input: VertexOutput, front: bool) -> GemUvs {
    let layer = i32(material.restoration[10].x);
    let ao = i32(material.restoration[10].y);

    if layer == -1 && ao == -1 { return gem_uv_m1_m1(input, front); }

    if layer == -1 && ao == 0 { return gem_uv_m1_p0(input, front); }

    if layer == -1 && ao == 1 { return gem_uv_m1_p1(input, front); }

    if layer == 0 && ao == -1 { return gem_uv_p0_m1(input, front); }

    if layer == 0 && ao == 0 { return gem_uv_p0_p0(input, front); }

    if layer == 0 && ao == 1 { return gem_uv_p0_p1(input, front); }

    if layer == 1 && ao == -1 { return gem_uv_p1_m1(input, front); }

    if layer == 1 && ao == 0 { return gem_uv_p1_p0(input, front); }

    return gem_uv_p1_p1(input, front);
}

